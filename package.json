{
  "name": "context-compiler",
  "version": "0.1.0",
  "description": "Task-aware, token-budgeted file-to-markdown compiler for AI agents (MCP server + hosted workspace)",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "context-compiler": "dist/mcp/server.js"
  },
  "scripts": {
    "build:engine": "tsc",
    "build:api": "npm run build -w @cc/api",
    "build:web": "npm run build -w @cc/web",
    "build": "npm run build:engine && npm run build:api && npm run build:web",
    "build:test": "npm run build:engine",
    "test": "npm run build:test && NODE_ENV=test node dist/tests/test.js",
    "smoke:postbuild": "node scripts/postbuild-smoke.mjs",
    "mcp": "node dist/mcp/server.js",
    "web": "node scripts/start-dual.mjs",
    "api:dev": "npm run build:engine && npm run build:api && API_PORT=4000 API_HOST=127.0.0.1 npm run start -w @cc/api",
    "web:dev": "API_PORT=4000 npm run dev -w @cc/web",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.{js,json}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "express": "^4.21.0",
    "js-tiktoken": "^1.0.15",
    "multer": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
