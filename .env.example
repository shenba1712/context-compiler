# Hosted dual-process ports
PORT=8000
API_PORT=4000
API_HOST=127.0.0.1

# Optional workspace layout rollout (set to 1 to enable the passive task rail)
NEXT_PUBLIC_CC_WORKSPACE_REVAMP=0

# Optional LLM providers (Compile and MCP do not need a key)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local paths and hosted limits
CC_ROOT=
CC_CACHE_DIR=
CC_MAX_FILE_BYTES=20971520
CC_RATE_LIMIT=100
CC_RATE_COST_AGENT=12
CC_RATE_COST_ANSWER=4
CC_MAX_CONCURRENT_CONVERSIONS=3
CC_MAX_QUEUED_CONVERSIONS=12
CC_MAX_CONCURRENT_LLM=2
CC_LLM_TIMEOUT_MS=30000
